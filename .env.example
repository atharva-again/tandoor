# Telegram bot token from BotFather.
TANDOOR_TELEGRAM_BOT_TOKEN=

# Configure at least one allowlist. IDs are comma-separated if there are several.
TANDOOR_ALLOWED_USER_IDS=123456789

# Optional settings (defaults shown):
# TANDOOR_DATA_DIR=/home/your-user/.local/share/tandoor
# TANDOOR_WORKER_IMAGE=localhost/tandoor-worker:dev
# TANDOOR_PODMAN=podman
# TANDOOR_MODEL_PROVIDER=openai-codex  # also: openai or xai
# TANDOOR_MODEL_ID=gpt-6-luna
# Existing/default Gog OAuth client file (keep this if you already have accounts
# connected with the Desktop client; it remains the default client).
# TANDOOR_GOOGLE_OAUTH_CLIENT_FILE=/absolute/path/to/google-oauth-client.json
# New Google sign-ins use a separate Web application OAuth client and named Gog
# client, preserving tokens from the existing Desktop client. The gateway imports
# this JSON into a versioned Podman secret and mounts it read-only in workers.
# Keep the source file outside the repo and readable only by your user.
# TANDOOR_GOOGLE_OAUTH_WEB_CLIENT_FILE=/absolute/path/to/google-web-oauth-client.json
# Register this exact URI on the Web client. Cloudflare Tunnel should route the
# auth hostname to the gateway's loopback callback listener.
# TANDOOR_GOOGLE_OAUTH_REDIRECT_URI=https://auth.atharvaverma.com/oauth/google/callback
# TANDOOR_GOOGLE_OAUTH_CALLBACK_PORT=8787

# Optional public web search and extraction through Context.dev.
# The key stays in the gateway; Durable workers receive only an enabled/disabled flag.
# All configured Tandoor scopes share this service account and its API quota.
# TANDOOR_CONTEXT_DEV_API_KEY=
